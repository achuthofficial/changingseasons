VITE_SUPABASE_URL=your-supabase-project-url
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key

# Direct Postgres connection — server-side / CLI tooling ONLY. Never prefix
# with VITE_, never import into src/ code (it would ship to the browser).
DATABASE_URL=postgresql://postgres:your-url-encoded-password@db.your-project-ref.supabase.co:5432/postgres
PGHOST=db.your-project-ref.supabase.co
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=your-password
